<% layout('layouts/boilerplate') %>

    <header class="page-hero">
        <div class="container">
            <p class="eyebrow">Something went wrong</p>
            <h1 class="page-title">Error <%= statusCode %></h1>
            <div class="flourish"><i class="fas fa-star"></i></div>
            <p class="page-hero-sub"><%= err.message %></p>
        </div>
    </header>
    <section class="section text-center">
        <div class="container">
            <a href="/" class="btn-green">Back to home</a>
        </div>
    </section>