<% layout('layouts/boilerplate') %>
    <link rel="stylesheet" href="/stylesheets/contact.css">

    <!-- ============================== PAGE HERO ============================== -->
    <header class="page-hero">
        <div class="container">
            <p class="eyebrow">Let's talk</p>
            <h1 class="page-title">Get in Touch</h1>
            <div class="flourish"><i class="fas fa-star"></i></div>
            <p class="page-hero-sub">Making that first contact takes courage. Call, text, or send a message, and I'll
                get back to you as soon as I can.</p>
        </div>
    </header>

    <!-- ============================== CONTACT ============================== -->
    <section class="section">
        <div class="container">
            <div class="row g-5 justify-content-center">

                <!-- Left: details -->
                <div class="col-lg-5 contact-info" data-aos="fade-right">
                    <p>This is where the rubber meets the road: making that first contact. You can call me, send me a
                        text, or send me an email using the form on this page, and I'll get back to you as soon as I
                        can. Whatever method feels right to you is fine with me. Please give yourself credit for doing
                        this; it takes courage and strength to ask for help.</p>

                    <div class="contact-detail">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>
                            <span class="label">Office</span>
                            5290 E. Yale Circle, Suite #201<br>Denver, Colorado 80222
                        </span>
                    </div>
                    <div class="contact-detail">
                        <i class="fas fa-phone-alt"></i>
                        <span>
                            <span class="label">Phone</span>
                            720.635.6274
                        </span>
                    </div>

                    <a class="btn btn-success mt-4" data-bs-toggle="collapse" href="#collapseDetails" role="button"
                        aria-expanded="false" aria-controls="collapseDetails">
                        View rates &amp; payment information
                    </a>
                    <div class="collapse" id="collapseDetails">
                        <div class="card card-body rates-card">
                            <div class="rate-row"><span class="fw-bold">Cost per session</span><span>$205</span></div>
                            <div class="rate-row"><span class="fw-bold">Pay by</span><span>All Major Credit Cards, Cash,
                                    Check, Health Savings Account (HSA), Venmo, Zelle</span></div>
                            <p class="fst-italic mt-3 mb-0">Please note, I do not file insurance. I will provide you
                                with
                                a bill that you can file, and I'll also help you with filing the claim, filling out
                                forms, and so on.</p>
                        </div>
                    </div>

                    <div class="contact-note mt-4">Please do not send personal health information through this form. We
                        are not able to answer mental health related questions or provide specific mental health advice
                        through the form.</div>
                </div>

                <!-- Right: form -->
                <div class="col-lg-6" data-aos="fade-left">
                    <div class="contact-card">
                        <script type="text/javascript" src="https://form.jotform.com/jsform/240037725359155"></script>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <script>
        // Disable form submissions if there are invalid fields
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                const forms = document.getElementsByClassName('validated-form');
                Array.from(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
    <script src="/javascripts/contact.js"></script>